<%- include('partials/header', { title: 'Lua Script Playground - Roblox Script Nexus' }) %>

<!-- CodeMirror 6 Dependencies via CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css">

<main class="container py-4 flex-grow-1">

  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="display-6 font-orbitron text-neon-cyan mb-1"><i class="fa-solid fa-terminal me-2"></i>LUA SCRIPT PLAYGROUND</h1>
      <p class="text-secondary mb-0">Test and simulate Roblox Lua scripts safely in a sandboxed interactive environment.</p>
    </div>
    <span class="badge bg-dark-glass text-cyan border-cyan px-3 py-2 font-orbitron">SANDBOXED DEMO</span>
  </div>

  <div class="row g-4">
    <!-- Code Editor Column -->
    <div class="col-lg-8">
      <div class="card glass-card border-purple rounded-4 overflow-hidden shadow-cyan">
        <div class="card-header bg-transparent border-purple d-flex flex-wrap align-items-center justify-content-between gap-3 p-3">
          <div class="d-flex align-items-center gap-2">
            <label for="templateSelect" class="text-secondary small font-orbitron text-uppercase mb-0">Template:</label>
            <select id="templateSelect" class="form-select form-select-sm bg-dark-glass text-light border-cyan" style="width: 220px;">
              <option value="default">Custom Lua Script</option>
              <% if (maps && maps.length > 0) { %>
                <% maps.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.name %> Sample</option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div class="d-flex align-items-center gap-2">
            <button id="obfuscateBtn" class="btn btn-outline-warning btn-sm font-orbitron" onclick="openObfuscatorModal()">
              <i class="fa-solid fa-user-ninja me-1"></i> Lua Obfuscator
            </button>
            <button id="clearEditorBtn" class="btn btn-outline-secondary btn-sm font-orbitron">
              <i class="fa-solid fa-eraser me-1"></i> Clear
            </button>
            <button id="runScriptBtn" class="btn btn-cyan text-dark btn-sm font-orbitron fw-bold px-4">
              <i class="fa-solid fa-play me-1"></i> RUN SIMULATOR
            </button>
          </div>
        </div>

        <div class="card-body p-0">
          <textarea id="luaCodeEditor" class="form-control">-- Roblox Script Nexus Sandbox Playground
-- Write or paste your Lua script below to simulate execution.

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

print("[NEXUS] Initializing Script Nexus Hub v2.5...")
print("[NEXUS] Local Player Identified: " .. (LocalPlayer and LocalPlayer.Name or "Developer"))

task.wait(0.5)
print("[NEXUS] Loading Aimbot & ESP Visual Modules...")
print("[NEXUS] Execution Complete! All features active.")
</textarea>
        </div>
      </div>
    </div>

    <!-- Output Console Column -->
    <div class="col-lg-4">
      <div class="card glass-card border-cyan rounded-4 h-100 d-flex flex-column">
        <div class="card-header bg-transparent border-cyan d-flex align-items-center justify-content-between py-3">
          <h5 class="font-orbitron text-neon-cyan mb-0"><i class="fa-solid fa-desktop me-2"></i>OUTPUT CONSOLE</h5>
          <button id="clearConsoleBtn" class="btn btn-sm text-secondary hover-cyan p-0 border-0">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>

        <div class="card-body p-3 bg-dark-gradient flex-grow-1 font-monospace text-light rounded-bottom-4 overflow-y-auto" style="max-height: 450px; font-size: 0.85rem;" id="consoleOutput">
          <div class="text-secondary font-italic">[Console Ready. Click "RUN SIMULATOR" to test execution output.]</div>
        </div>
      </div>
    </div>
  </div>

</main>

<!-- Lua Obfuscator Modal -->
<div class="modal fade" id="obfuscatorModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content glass-card border-zinc text-light rounded-4 shadow-lg">
      <div class="modal-header border-secondary">
        <h5 class="modal-title font-orbitron text-white"><i class="fa-solid fa-shield-halved text-warning me-2"></i>LUA SCRIPT OBFUSCATOR & PROTECTOR</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-4">
        <p class="text-zinc-muted small mb-3">Obfuscate your Roblox Lua script code to prevent theft, reverse engineering, and decompilation.</p>

        <div class="mb-3">
          <label class="form-label font-orbitron text-white small">Obfuscated Lua Code Output:</label>
          <textarea id="obfuscatedOutputArea" class="form-control bg-dark text-emerald font-monospace small" rows="8" readonly></textarea>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-warning rounded-pill font-orbitron w-50" onclick="processLuaObfuscation()">
            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Obfuscate Current Code
          </button>
          <button class="btn btn-zinc-white rounded-pill font-orbitron w-50" onclick="copyObfuscatedLua()">
            <i class="fa-solid fa-copy me-1"></i> Copy Obfuscated Code
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- CodeMirror JS Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/lua/lua.min.js"></script>
<script src="/js/playground.js"></script>
<script>
  function openObfuscatorModal() {
    const modal = new bootstrap.Modal(document.getElementById('obfuscatorModal'));
    modal.show();
    processLuaObfuscation();
  }

  function processLuaObfuscation() {
    const rawCode = window.luaEditor ? window.luaEditor.getValue() : document.getElementById('luaCodeEditor').value;
    if (!rawCode.trim()) {
      document.getElementById('obfuscatedOutputArea').value = '-- Error: No code provided in editor.';
      return;
    }

    // Convert strings to hex encoded Lua byte arrays
    let hexEncoded = '';
    for (let i = 0; i < rawCode.length; i++) {
      hexEncoded += '\\' + rawCode.charCodeAt(i);
    }

    const varName = 'v_' + Math.random().toString(36).substring(2, 8);
    const obfuscated = `-- Roblox Script Nexus Lua Protector v2.0\nlocal ${varName} = "${hexEncoded}"\nloadstring(game:HttpGet("${window.location.protocol}//${window.location.host}/api/scripts/1/load"))()\n-- Protected Payload Signature: NEXUS_${Math.floor(Math.random()*899999+100000)}`;

    document.getElementById('obfuscatedOutputArea').value = obfuscated;
  }

  function copyObfuscatedLua() {
    const code = document.getElementById('obfuscatedOutputArea').value;
    navigator.clipboard.writeText(code).then(() => {
      if (window.showToast) showToast('Obfuscated Lua code copied to clipboard!', 'success');
      else alert('Obfuscated Lua code copied!');
    });
  }
</script>

<%- include('partials/footer') %>

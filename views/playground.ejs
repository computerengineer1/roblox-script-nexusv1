<%- include('partials/header', { title: 'Lua Script Playground - Roblox Script Nexus' }) %>

<!-- CodeMirror 6 Dependencies via CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css">

<main class="container py-4 flex-grow-1">

  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="display-6 font-orbitron text-neon-cyan mb-1"><i class="fa-solid fa-terminal me-2"></i>LUA SCRIPT PLAYGROUND</h1>
      <p class="text-secondary mb-0">Test and simulate Roblox Lua scripts safely in a sandboxed interactive environment.</p>
    </div>
    <span class="badge bg-dark-glass text-cyan border-cyan px-3 py-2 font-orbitron">SANDBOXED DEMO</span>
  </div>

  <div class="row g-4">
    <!-- Code Editor Column -->
    <div class="col-lg-8">
      <div class="card glass-card border-purple rounded-4 overflow-hidden shadow-cyan">
        <div class="card-header bg-transparent border-purple d-flex flex-wrap align-items-center justify-content-between gap-3 p-3">
          <div class="d-flex align-items-center gap-2">
            <label for="templateSelect" class="text-secondary small font-orbitron text-uppercase mb-0">Template:</label>
            <select id="templateSelect" class="form-select form-select-sm bg-dark-glass text-light border-cyan" style="width: 220px;">
              <option value="default">Custom Lua Script</option>
              <% if (maps && maps.length > 0) { %>
                <% maps.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.name %> Sample</option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div class="d-flex align-items-center gap-2">
            <button id="clearEditorBtn" class="btn btn-outline-secondary btn-sm font-orbitron">
              <i class="fa-solid fa-eraser me-1"></i> Clear
            </button>
            <button id="runScriptBtn" class="btn btn-cyan text-dark btn-sm font-orbitron fw-bold px-4">
              <i class="fa-solid fa-play me-1"></i> RUN SIMULATOR
            </button>
          </div>
        </div>

        <div class="card-body p-0">
          <textarea id="luaCodeEditor" class="form-control">-- Roblox Script Nexus Sandbox Playground
-- Write or paste your Lua script below to simulate execution.

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

print("[NEXUS] Initializing Script Nexus Hub v2.5...")
print("[NEXUS] Local Player Identified: " .. (LocalPlayer and LocalPlayer.Name or "Developer"))

task.wait(0.5)
print("[NEXUS] Loading Aimbot & ESP Visual Modules...")
print("[NEXUS] Execution Complete! All features active.")
</textarea>
        </div>
      </div>
    </div>

    <!-- Output Console Column -->
    <div class="col-lg-4">
      <div class="card glass-card border-cyan rounded-4 h-100 d-flex flex-column">
        <div class="card-header bg-transparent border-cyan d-flex align-items-center justify-content-between py-3">
          <h5 class="font-orbitron text-neon-cyan mb-0"><i class="fa-solid fa-desktop me-2"></i>OUTPUT CONSOLE</h5>
          <button id="clearConsoleBtn" class="btn btn-sm text-secondary hover-cyan p-0 border-0">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>

        <div class="card-body p-3 bg-dark-gradient flex-grow-1 font-monospace text-light rounded-bottom-4 overflow-y-auto" style="max-height: 450px; font-size: 0.85rem;" id="consoleOutput">
          <div class="text-secondary font-italic">[Console Ready. Click "RUN SIMULATOR" to test execution output.]</div>
        </div>
      </div>
    </div>
  </div>

</main>

<!-- CodeMirror JS Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/lua/lua.min.js"></script>
<script src="/js/playground.js"></script>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Home - Roblox Script Vault' }) %>

<main class="container py-4 flex-grow-1">
  
  <!-- Hero & Live Visual Search Section -->
  <section class="hero-section text-center py-5 mb-4 position-relative">
    <div class="glow-sphere cyan"></div>
    <div class="glow-sphere purple"></div>
    
    <h1 class="display-4 font-orbitron fw-extrabold text-neon-cyan mb-3">
      ROBLOX SCRIPT <span class="text-neon-purple">NEXUS</span>
    </h1>
    <p class="lead text-secondary max-w-700 mx-auto mb-4">
      Discover, preview, and build custom script loadouts for your favorite Roblox game maps. 100% Free & Updated Daily.
    </p>

    <!-- Instant Live Search Bar -->
    <div class="search-wrapper max-w-650 mx-auto position-relative z-3">
      <div class="input-group input-group-lg search-input-group shadow-cyan">
        <span class="input-group-text bg-dark-glass text-cyan border-cyan">
          <i class="fa-solid fa-magnifying-glass"></i>
        </span>
        <input type="text" id="searchInput" class="form-control bg-dark-glass text-light border-cyan" placeholder="Search game maps or scripts (e.g., Blox Fruits, Aimbot)..." autocomplete="off">
        <button class="btn btn-cyan text-dark font-orbitron fw-bold px-4" type="button" id="searchBtn">
          SEARCH
        </button>
      </div>

      <!-- AJAX Live Search Results Dropdown -->
      <div id="searchResults" class="search-dropdown-menu rounded-3 glass-card position-absolute w-100 mt-2 shadow-lg text-start d-none">
        <div id="searchResultsList" class="list-group list-group-flush p-2"></div>
      </div>
    </div>
  </section>

  <!-- Featured Maps Carousel -->
  <% if (featuredMaps && featuredMaps.length > 0) { %>
    <section class="featured-section mb-5">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="font-orbitron text-neon-purple mb-0"><i class="fa-solid fa-fire me-2"></i>FEATURED MAPS</h3>
        <span class="badge bg-dark-glass text-cyan border-cyan px-3 py-2">TOP TRENDING</span>
      </div>

      <div id="featuredCarousel" class="carousel slide carousel-fade rounded-4 overflow-hidden border-cyan shadow-cyan" data-bs-ride="carousel">
        <div class="carousel-indicators">
          <% featuredMaps.forEach((map, index) => { %>
            <button type="button" data-bs-target="#featuredCarousel" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? 'active' : '' %>" aria-label="Slide <%= index + 1 %>"></button>
          <% }) %>
        </div>
        
        <div class="carousel-inner">
          <% featuredMaps.forEach((map, index) => { %>
            <div class="carousel-item <%= index === 0 ? 'active' : '' %>" style="height: 380px;">
              <img src="<%= map.image || 'https://via.placeholder.com/800x400/0a0a1a/00f0ff?text=' + encodeURIComponent(map.name) %>" class="d-block w-100 h-100 object-fit-cover filter-brightness" alt="<%= map.name %>">
              <div class="carousel-caption d-md-block text-start p-4 glass-card mx-3 mb-3 rounded-3 border-cyan">
                <span class="badge bg-purple mb-2"><%= map.script_count || 0 %> Scripts Available</span>
                <h2 class="font-orbitron text-neon-cyan mb-2"><%= map.name %></h2>
                <p class="text-light text-truncate mb-3"><%= map.description %></p>
                <a href="/map/<%= map.id %>" class="btn btn-cyan text-dark font-orbitron fw-bold px-4 rounded-pill">
                  EXPLORE SCRIPTS <i class="fa-solid fa-arrow-right ms-2"></i>
                </a>
              </div>
            </div>
          <% }) %>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#featuredCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#featuredCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </section>
  <% } %>

  <!-- AdSense Spot #1: Below Carousel -->
  <%- include('partials/adsense', { pos: 'Homepage Banner' }) %>

  <!-- All Maps Grid Section -->
  <section class="maps-grid-section py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h3 class="font-orbitron text-neon-cyan mb-0"><i class="fa-solid fa-gamepad me-2"></i>GAME MAP VAULT</h3>
      <span class="text-secondary small">Total Maps: <%= maps ? maps.length : 0 %></span>
    </div>

    <div class="row g-4" id="mapsGrid">
      <% if (maps && maps.length > 0) { %>
        <% maps.forEach(map => { %>
          <div class="col-12 col-md-6 col-lg-4 map-card-col">
            <div class="card map-card h-100 glass-card border-purple rounded-4 overflow-hidden position-relative hover-lift">
              <div class="map-image-wrapper overflow-hidden position-relative" style="height: 200px;">
                <img src="<%= map.image || 'https://via.placeholder.com/800x400/0a0a1a/b300ff?text=' + encodeURIComponent(map.name) %>" class="card-img-top w-100 h-100 object-fit-cover map-img" alt="<%= map.name %>">
                <div class="map-overlay-badge position-absolute top-0 end-0 m-3">
                  <span class="badge bg-dark-glass border-cyan text-cyan font-orbitron px-3 py-2">
                    <i class="fa-solid fa-code me-1"></i> <%= map.script_count || 0 %> Scripts
                  </span>
                </div>
              </div>
              
              <div class="card-body d-flex flex-column p-4">
                <h4 class="card-title font-orbitron text-neon-cyan mb-2"><%= map.name %></h4>
                <p class="card-text text-secondary small line-clamp-2 mb-4 flex-grow-1">
                  <%= map.description %>
                </p>
                <div class="d-flex align-items-center justify-content-between mt-auto">
                  <a href="/map/<%= map.id %>" class="btn btn-outline-cyan rounded-pill w-100 font-orbitron fw-bold text-uppercase py-2">
                    View Scripts <i class="fa-solid fa-chevron-right ms-1"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <p class="text-secondary fs-5">No game maps found in database. Run seed script to add default maps.</p>
        </div>
      <% } %>
    </div>
  </section>

</main>

<%- include('partials/footer') %>

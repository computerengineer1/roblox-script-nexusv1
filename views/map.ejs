<%- include('partials/header', { title: map.name + ' Scripts - Roblox Script Nexus' }) %>

<main class="container py-4 flex-grow-1">

  <!-- Map Header Hero Section -->
  <section class="map-hero glass-card border-cyan rounded-4 p-4 p-md-5 mb-4 position-relative overflow-hidden">
    <div class="row align-items-center">
      <div class="col-lg-5 mb-4 mb-lg-0">
        <div class="rounded-4 overflow-hidden shadow-cyan border-purple" style="max-height: 300px;">
          <img src="<%= map.image || 'https://via.placeholder.com/800x400/0a0a1a/00f0ff?text=' + encodeURIComponent(map.name) %>" class="w-100 h-100 object-fit-cover" alt="<%= map.name %>">
        </div>
      </div>
      <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge bg-purple px-3 py-2 font-orbitron"><i class="fa-solid fa-gamepad me-1"></i> MAP VAULT</span>
          <% if (isWatching) { %>
            <span class="badge bg-success text-white px-3 py-2 font-orbitron"><i class="fa-solid fa-eye me-1"></i> WATCHING</span>
          <% } %>
        </div>
        
        <h1 class="display-5 font-orbitron text-neon-cyan fw-bold mb-3"><%= map.name %></h1>
        <p class="text-secondary lead mb-4"><%= map.description %></p>
        
        <div class="d-flex flex-wrap align-items-center gap-3">
          <a href="/subscribe/<%= map.id %>" class="btn <%= isWatching ? 'btn-outline-success' : 'btn-outline-purple' %> rounded-pill px-4 font-orbitron">
            <i class="fa-solid <%= isWatching ? 'fa-check' : 'fa-bell' %> me-2"></i> <%= isWatching ? 'Watching Map' : 'Watch Map (Cookie Alert)' %>
          </a>
          <a href="#scriptsList" class="btn btn-cyan text-dark rounded-pill px-4 font-orbitron fw-bold">
            <i class="fa-solid fa-code me-2"></i> Browse <%= scripts.length %> Scripts
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Simulation Preview & Ad Section -->
  <div class="row g-4 mb-4">
    <!-- Live Preview Sandbox Component -->
    <div class="col-lg-8">
      <div class="card glass-card border-purple rounded-4 h-100">
        <div class="card-header bg-transparent border-purple d-flex align-items-center justify-content-between py-3">
          <h5 class="font-orbitron text-neon-cyan mb-0"><i class="fa-solid fa-play-circle me-2"></i>LIVE SCRIPT PREVIEW SIMULATOR</h5>
          <span class="badge bg-dark-glass text-secondary">Canvas Demo</span>
        </div>
        <div class="card-body p-4 text-center d-flex flex-column align-items-center justify-content-center min-h-250 position-relative">
          <canvas id="previewCanvas" width="600" height="220" class="w-100 rounded-3 border border-secondary bg-dark-gradient mb-3"></canvas>
          <div class="preview-controls d-flex gap-2">
            <button class="btn btn-sm btn-outline-cyan font-orbitron" onclick="runSimulatedPreview('ESP')"><i class="fa-solid fa-eye me-1"></i> Test ESP</button>
            <button class="btn btn-sm btn-outline-purple font-orbitron" onclick="runSimulatedPreview('Aimbot')"><i class="fa-solid fa-crosshair me-1"></i> Test Aimbot</button>
            <button class="btn btn-sm btn-outline-light font-orbitron" onclick="runSimulatedPreview('Farm')"><i class="fa-solid fa-rotate me-1"></i> Test AutoFarm</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar AdSense Spot #2 -->
    <div class="col-lg-4">
      <%- include('partials/adsense', { pos: 'Sidebar Rectangle' }) %>
    </div>
  </div>

  <!-- Scripts List Section -->
  <section id="scriptsList" class="py-3">
    <h3 class="font-orbitron text-neon-cyan mb-4"><i class="fa-solid fa-scroll me-2"></i>AVAILABLE SCRIPTS</h3>

    <% if (scripts && scripts.length > 0) { %>
      <div class="row g-4">
        <% scripts.forEach(script => { %>
          <div class="col-12">
            <div class="card glass-card border-purple rounded-4 overflow-hidden">
              <div class="card-header bg-transparent border-purple d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 p-md-4">
                <div>
                  <span class="badge bg-purple text-light px-3 py-1 font-orbitron mb-2"><%= script.category %></span>
                  <h4 class="font-orbitron text-neon-cyan mb-0"><%= script.title %></h4>
                </div>
                
                <div class="d-flex align-items-center gap-2">
                  <button class="btn btn-outline-purple btn-sm rounded-pill font-orbitron px-3" 
                          onclick="addToLoadout('<%= script.id %>', '<%= script.title.replace(/'/g, "\\'") %>', `<%= script.code.replace(/`/g, '\\`') %>`)">
                    <i class="fa-solid fa-plus me-1"></i> Add to Loadout
                  </button>
                  
                  <button class="btn btn-cyan btn-sm text-dark font-orbitron fw-bold rounded-pill px-4 copy-script-btn"
                          data-script-id="<%= script.id %>"
                          data-script-title="<%= script.title %>"
                          data-script-code="<%= script.code %>">
                    <i class="fa-solid fa-copy me-1"></i> Copy Script
                  </button>
                </div>
              </div>

              <div class="card-body p-3 p-md-4 border-top border-purple">
                <p class="text-secondary small mb-3"><%= script.description %></p>

                <!-- Lua Code Box Preview -->
                <div class="position-relative">
                  <pre class="bg-dark-gradient p-3 rounded-3 text-light border border-secondary overflow-x-auto fs-6 font-monospace mb-0" style="max-height: 180px;"><code class="language-lua"><%= script.code %></code></pre>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="glass-card text-center p-5 rounded-4 border-purple">
        <i class="fa-solid fa-folder-open text-secondary fs-1 mb-3"></i>
        <h4 class="font-orbitron text-secondary">No Scripts Uploaded Yet</h4>
        <p class="text-muted">Scripts for this map will be published soon by the administrator.</p>
      </div>
    <% } %>
  </section>

</main>

<!-- 5-Second AdSense Copy Interstitial Modal -->
<div class="modal fade" id="copyAdModal" tabindex="-1" aria-labelledby="copyAdModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content glass-card border-cyan rounded-4 text-light">
      <div class="modal-header border-purple">
        <h5 class="modal-title font-orbitron text-neon-cyan" id="copyAdModalLabel">
          <i class="fa-solid fa-unlock me-2"></i>UNLOCKING ROBLOX SCRIPT
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <div class="modal-body text-center py-4">
        <p class="text-secondary mb-3">Please support our free platform. Script will copy automatically after sponsor view.</p>
        
        <!-- Ad Unit inside Modal -->
        <div class="my-3 p-3 bg-dark-gradient rounded border border-purple">
          <div class="text-cyan font-orbitron fw-bold mb-1"><i class="fa-solid fa-ad me-1"></i> SPONSOR ANNOUNCEMENT</div>
          <small class="text-muted">AdSense Unit — Unlocking Script Payload</small>
        </div>

        <div class="countdown-wrapper mt-4">
          <button id="skipAdBtn" class="btn btn-purple font-orbitron fw-bold px-5 py-2 rounded-pill" disabled>
            <i class="fa-solid fa-spinner fa-spin me-2" id="adSpinner"></i>
            SKIP AD IN <span id="adCountdown">5</span>s
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/copy-ad.js"></script>
<script>
  // Simple Canvas Simulation Preview Script
  function runSimulatedPreview(type) {
    const canvas = document.getElementById('previewCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    // Background
    ctx.fillStyle = '#0a0a1a';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    // Grid Lines
    ctx.strokeStyle = 'rgba(0, 240, 255, 0.15)';
    ctx.lineWidth = 1;
    for(let x = 0; x < canvas.width; x += 30) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
    }
    for(let y = 0; y < canvas.height; y += 30) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
    }

    if (type === 'ESP') {
      // Draw ESP Boxes
      ctx.strokeStyle = '#00f0ff';
      ctx.lineWidth = 2;
      ctx.strokeRect(150, 40, 60, 120);
      ctx.fillStyle = '#00f0ff';
      ctx.font = '12px Orbitron';
      ctx.fillText('Player1 [100m]', 140, 30);

      ctx.strokeStyle = '#b300ff';
      ctx.strokeRect(380, 70, 50, 100);
      ctx.fillStyle = '#b300ff';
      ctx.fillText('Enemy [45m]', 375, 60);
    } else if (type === 'Aimbot') {
      // Draw FOV Circle & Crosshair
      ctx.strokeStyle = '#00f0ff';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(canvas.width/2, canvas.height/2, 70, 0, Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = '#ff0055';
      ctx.fillRect(canvas.width/2 - 4, canvas.height/2 - 4, 8, 8);
      ctx.fillStyle = '#00f0ff';
      ctx.font = '12px Orbitron';
      ctx.fillText('AIMBOT FOV LOCK ACTIVE', canvas.width/2 - 80, canvas.height/2 + 95);
    } else {
      // AutoFarm Animation
      ctx.fillStyle = '#b300ff';
      ctx.font = '14px Orbitron';
      ctx.fillText('⚡ AUTOFARM ACTIVE: Collecting Coins + Auto-Attacking Mobs...', 80, canvas.height/2);
    }
  }

  // Run initial ESP canvas simulation on load
  document.addEventListener('DOMContentLoaded', () => runSimulatedPreview('ESP'));
</script>

<%- include('partials/footer') %>

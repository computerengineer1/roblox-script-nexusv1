<%- include('partials/header', { title: map.name + ' Scripts - Roblox Script Nexus' }) %>

<main class="container py-4 flex-grow-1">

  <!-- Map Header Hero Section -->
  <section class="map-hero glass-card border-zinc rounded-4 p-4 p-md-5 mb-4 position-relative overflow-hidden">
    <div class="row align-items-center">
      <div class="col-lg-5 mb-4 mb-lg-0">
        <div class="rounded-4 overflow-hidden shadow-lg border border-secondary" style="max-height: 280px;">
          <img src="<%= map.image || 'https://via.placeholder.com/800x400/09090b/27272a?text=' + encodeURIComponent(map.name) %>" class="w-100 h-100 object-fit-cover" alt="<%= map.name %>">
        </div>
      </div>
      <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge bg-dark border border-secondary text-zinc-light font-orbitron px-3 py-2"><i class="fa-solid fa-cube me-1 text-emerald"></i> MAP VAULT</span>
          <% if (isWatching) { %>
            <span class="badge bg-dark text-emerald border border-secondary px-3 py-2 font-orbitron"><i class="fa-solid fa-eye me-1"></i> WATCHING</span>
          <% } %>
        </div>
        
        <h1 class="display-5 font-orbitron text-white fw-bold mb-3"><%= map.name %></h1>
        <p class="text-zinc-muted lead mb-4"><%= map.description %></p>
        
        <div class="d-flex flex-wrap align-items-center gap-3">
          <a href="/subscribe/<%= map.id %>" class="btn <%= isWatching ? 'btn-zinc-dark text-emerald' : 'btn-outline-zinc' %> rounded-pill px-4 font-orbitron">
            <i class="fa-solid <%= isWatching ? 'fa-check' : 'fa-bell' %> me-2"></i> <%= isWatching ? 'Watching Map' : 'Watch Map (Cookie Alert)' %>
          </a>
          <a href="#scriptsList" class="btn btn-zinc-white rounded-pill px-4 font-orbitron">
            <i class="fa-solid fa-code me-2"></i> Browse <%= scripts.length %> Scripts
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Simulation Preview & Ad Section -->
  <div class="row g-4 mb-4">
    <!-- Live Preview Sandbox Component -->
    <div class="col-lg-8">
      <div class="card glass-card border-zinc rounded-4 h-100">
        <div class="card-header bg-transparent border-zinc d-flex align-items-center justify-content-between py-3">
          <h5 class="font-orbitron text-white mb-0"><i class="fa-solid fa-play-circle me-2 text-emerald"></i>LIVE SCRIPT PREVIEW SIMULATOR</h5>
          <span class="badge bg-dark text-zinc-muted border border-secondary">Canvas Demo</span>
        </div>
        <div class="card-body p-4 text-center d-flex flex-column align-items-center justify-content-center min-h-250 position-relative">
          <canvas id="previewCanvas" width="600" height="220" class="w-100 rounded-3 border border-secondary bg-dark-gradient mb-3"></canvas>
          <div class="preview-controls d-flex gap-2">
            <button class="btn btn-sm btn-outline-zinc font-orbitron" onclick="runSimulatedPreview('ESP')"><i class="fa-solid fa-eye me-1"></i> Test ESP</button>
            <button class="btn btn-sm btn-outline-zinc font-orbitron" onclick="runSimulatedPreview('Aimbot')"><i class="fa-solid fa-crosshair me-1"></i> Test Aimbot</button>
            <button class="btn btn-sm btn-outline-zinc font-orbitron" onclick="runSimulatedPreview('Farm')"><i class="fa-solid fa-rotate me-1"></i> Test AutoFarm</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar AdSense Spot #2 -->
    <div class="col-lg-4">
      <%- include('partials/adsense', { pos: 'Sidebar Rectangle' }) %>
    </div>
  </div>

  <!-- Category Filter Tabs & Scripts List Section -->
  <section id="scriptsList" class="py-3">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
      <h3 class="font-orbitron text-white mb-0"><i class="fa-solid fa-scroll me-2 text-zinc-muted"></i>AVAILABLE SCRIPTS</h3>
      
      <!-- Category Filter Pills -->
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-zinc-dark btn-sm rounded-pill px-3 active filter-category-btn" data-category="ALL">All</button>
        <button class="btn btn-outline-zinc btn-sm rounded-pill px-3 filter-category-btn" data-category="Farming">Farming</button>
        <button class="btn btn-outline-zinc btn-sm rounded-pill px-3 filter-category-btn" data-category="Combat">Combat</button>
        <button class="btn btn-outline-zinc btn-sm rounded-pill px-3 filter-category-btn" data-category="ESP">ESP</button>
        <button class="btn btn-outline-zinc btn-sm rounded-pill px-3 filter-category-btn" data-category="Utility">Utility</button>
      </div>
    </div>

    <% if (scripts && scripts.length > 0) { %>
      <div class="row g-4" id="scriptsGrid">
        <% scripts.forEach(script => { 
             const loaderShortcut = `loadstring(game:HttpGet("${protocol}://${reqHeadersHost}/api/scripts/${script.id}/load"))()`;
             const isLoggedIn = typeof currentUser !== 'undefined' && currentUser;
        %>
          <div class="col-12 script-card-item" data-category="<%= script.category %>">
            <div class="card glass-card border-zinc rounded-4 overflow-hidden shadow-lg hover-glow">
              <div class="card-header bg-transparent border-zinc d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 p-md-4">
                <div>
                  <span class="badge bg-dark border border-secondary text-zinc-light font-orbitron mb-2 me-2"><%= script.category %></span>
                  <span class="badge bg-dark text-emerald border border-secondary font-orbitron mb-2"><i class="fa-solid fa-check-double me-1"></i> UNDETECTED</span>
                  <h4 class="font-orbitron text-white mb-0"><%= script.title %></h4>
                </div>
                
                <div class="d-flex align-items-center gap-2">
                  <!-- Like Button -->
                  <button class="btn btn-zinc-dark btn-sm rounded-pill px-3 like-script-btn" data-script-id="<%= script.id %>">
                    <i class="fa-solid fa-heart me-1 text-rose like-btn-heart"></i> <span class="like-count"><%= script.like_count || 0 %></span>
                  </button>

                  <% if (isLoggedIn) { %>
                    <button class="btn btn-outline-zinc btn-sm rounded-pill font-orbitron px-3" 
                            onclick="addToLoadout('<%= script.id %>', '<%= script.title.replace(/'/g, "\\'") %>', `<%= loaderShortcut %>`)">
                      <i class="fa-solid fa-plus me-1"></i> Add to Loadout
                    </button>
                    
                    <button class="btn btn-zinc-white btn-sm px-4 copy-script-btn font-orbitron"
                            data-script-id="<%= script.id %>"
                            data-script-title="<%= script.title %>"
                            data-script-code="<%= loaderShortcut %>">
                      <i class="fa-solid fa-copy me-1"></i> Copy Loader
                    </button>
                  <% } else { %>
                    <a href="/profile" class="btn btn-zinc-white btn-sm px-4 font-orbitron">
                      <i class="fa-solid fa-lock me-1"></i> Sign In to Copy
                    </a>
                  <% } %>
                </div>
              </div>

              <div class="card-body p-3 p-md-4 border-top border-zinc">
                <p class="text-zinc-muted small mb-3"><%= script.description %></p>

                <!-- Protected Loadstring Code Box -->
                <div class="position-relative mb-4">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <small class="text-uppercase text-zinc-light font-orbitron" style="font-size: 0.75rem;"><i class="fa-solid fa-bolt me-1 text-emerald"></i> Executor Loadstring Shortcut</small>
                    <small class="text-zinc-subtle"><i class="fa-solid fa-shield-halved me-1 text-emerald"></i> Source Protected</small>
                  </div>
                  
                  <% if (isLoggedIn) { %>
                    <pre class="bg-dark-gradient p-3 rounded-3 text-white border border-secondary overflow-x-auto fs-6 font-monospace mb-0" style="max-height: 180px;"><code class="language-lua"><%= loaderShortcut %></code></pre>
                  <% } else { %>
                    <div class="bg-dark-gradient p-4 rounded-3 text-center border border-secondary">
                      <i class="fa-solid fa-lock text-zinc-muted fs-3 mb-2"></i>
                      <h6 class="font-orbitron text-white mb-1">PROTECTED EXECUTOR SCRIPT</h6>
                      <p class="text-zinc-muted small mb-3">Please sign in with your Google account to unlock and copy this script shortcut.</p>
                      <a href="/profile" class="btn btn-zinc-white btn-sm px-4 rounded-pill font-orbitron">
                        <i class="fa-solid fa-user me-1"></i> Sign In To Unlock
                      </a>
                    </div>
                  <% } %>
                </div>


                <!-- Community Comments Drawer -->
                <div class="comments-section bg-dark-glass p-3 rounded-3 border border-secondary">
                  <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="font-orbitron small text-white"><i class="fa-solid fa-comments me-1 text-zinc-muted"></i> COMMUNITY COMMENTS</span>
                    <button class="btn btn-link text-zinc-muted p-0 text-decoration-none small" type="button" data-bs-toggle="collapse" data-bs-target="#commentsCollapse<%= script.id %>">
                      Toggle Comments
                    </button>
                  </div>

                  <div class="collapse show" id="commentsCollapse<%= script.id %>">
                    <!-- Post Comment Form -->
                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                      <form class="comment-form mb-3" data-script-id="<%= script.id %>">
                        <div class="input-group">
                          <input type="text" class="form-control bg-dark text-white border-secondary small comment-input" placeholder="Write a comment..." required>
                          <button type="submit" class="btn btn-zinc-white btn-sm px-3">Post</button>
                        </div>
                      </form>
                    <% } else { %>
                      <p class="text-zinc-subtle small mb-3"><i class="fa-solid fa-info-circle me-1"></i> <a href="/profile" class="text-white">Sign in</a> to post comments.</p>
                    <% } %>

                    <!-- Comments List Container -->
                    <div class="comments-list" id="commentsList<%= script.id %>" data-script-id="<%= script.id %>">
                      <div class="text-center py-2 text-zinc-subtle small"><i class="fa-solid fa-spinner fa-spin me-1"></i> Loading comments...</div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="glass-card text-center p-5 rounded-4 border-zinc">
        <i class="fa-solid fa-folder-open text-zinc-subtle fs-1 mb-3"></i>
        <h4 class="font-orbitron text-zinc-muted">No Scripts Uploaded Yet</h4>
        <p class="text-zinc-subtle small">Scripts for this map will be published soon by the administrator.</p>
      </div>
    <% } %>
  </section>

</main>

<!-- 5-Second AdSense Copy Interstitial Modal -->
<div class="modal fade" id="copyAdModal" tabindex="-1" aria-labelledby="copyAdModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content glass-card border-zinc rounded-4 text-white">
      <div class="modal-header border-zinc">
        <h5 class="modal-title font-orbitron text-white" id="copyAdModalLabel">
          <i class="fa-solid fa-unlock me-2 text-emerald"></i>UNLOCKING ROBLOX SCRIPT
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <div class="modal-body text-center py-4">
        <p class="text-zinc-muted mb-3">Please support our free platform. Script will copy automatically after sponsor view.</p>
        
        <!-- Ad Unit inside Modal -->
        <div class="my-3 p-3 bg-dark-gradient rounded border border-secondary">
          <div class="text-white font-orbitron fw-bold mb-1"><i class="fa-solid fa-ad me-1 text-emerald"></i> SPONSOR ANNOUNCEMENT</div>
          <small class="text-zinc-muted">AdSense Unit — Unlocking Script Payload</small>
        </div>

        <div class="countdown-wrapper mt-4">
          <button id="skipAdBtn" class="btn btn-zinc-white font-orbitron px-5 py-2 rounded-pill" disabled>
            <i class="fa-solid fa-spinner fa-spin me-2" id="adSpinner"></i>
            SKIP AD IN <span id="adCountdown">5</span>s
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/copy-ad.js"></script>
<script>
  // Simple Canvas Simulation Preview Script
  function runSimulatedPreview(type) {
    const canvas = document.getElementById('previewCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    ctx.fillStyle = '#09090b';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
    ctx.lineWidth = 1;
    for(let x = 0; x < canvas.width; x += 30) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
    }
    for(let y = 0; y < canvas.height; y += 30) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
    }

    if (type === 'ESP') {
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 2;
      ctx.strokeRect(150, 40, 60, 120);
      ctx.fillStyle = '#10b981';
      ctx.font = '12px Orbitron';
      ctx.fillText('Player1 [100m]', 140, 30);

      ctx.strokeStyle = '#f43f5e';
      ctx.strokeRect(380, 70, 50, 100);
      ctx.fillStyle = '#f43f5e';
      ctx.fillText('Enemy [45m]', 375, 60);
    } else if (type === 'Aimbot') {
      ctx.strokeStyle = '#fafafa';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(canvas.width/2, canvas.height/2, 70, 0, Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = '#f43f5e';
      ctx.fillRect(canvas.width/2 - 4, canvas.height/2 - 4, 8, 8);
      ctx.fillStyle = '#fafafa';
      ctx.font = '12px Orbitron';
      ctx.fillText('AIMBOT FOV LOCK ACTIVE', canvas.width/2 - 80, canvas.height/2 + 95);
    } else {
      ctx.fillStyle = '#10b981';
      ctx.font = '14px Orbitron';
      ctx.fillText('⚡ AUTOFARM ACTIVE: Collecting Coins + Auto-Attacking Mobs...', 80, canvas.height/2);
    }
  }

  // Load comments & handles Likes
  document.addEventListener('DOMContentLoaded', () => {
    // Fetch comments for all visible scripts
    document.querySelectorAll('.comments-list').forEach(container => {
      const scriptId = container.getAttribute('data-script-id');
      fetchComments(scriptId, container);
    });

    // Handle Comment Submission
    document.querySelectorAll('.comment-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const scriptId = form.getAttribute('data-script-id');
        const input = form.querySelector('.comment-input');
        const content = input.value.trim();
        if (!content) return;

        try {
          const res = await fetch(`/api/scripts/${scriptId}/comments`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content })
          });
          const data = await res.json();
          if (data.success) {
            input.value = '';
            const container = document.getElementById(`commentsList${scriptId}`);
            fetchComments(scriptId, container);
          } else {
            alert(data.error || 'Failed to post comment');
          }
        } catch (err) {
          console.error(err);
        }
      });
    });

    // Handle Like Toggle
    document.querySelectorAll('.like-script-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const scriptId = btn.getAttribute('data-script-id');
        try {
          const res = await fetch(`/api/scripts/${scriptId}/like`, { method: 'POST' });
          const data = await res.json();
          if (data.success) {
            btn.querySelector('.like-count').textContent = data.likeCount;
          } else {
            alert(data.error || 'Please sign in to like scripts');
          }
        } catch (err) {
          console.error(err);
        }
      });
    });

    // Category Filter Handler
    document.querySelectorAll('.filter-category-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-category-btn').forEach(b => {
          b.classList.remove('active', 'btn-zinc-dark');
          b.classList.add('btn-outline-zinc');
        });
        btn.classList.add('active', 'btn-zinc-dark');
        btn.classList.remove('btn-outline-zinc');

        const cat = btn.getAttribute('data-category');
        document.querySelectorAll('.script-card-item').forEach(card => {
          const itemCat = card.getAttribute('data-category');
          if (cat === 'ALL' || itemCat.toLowerCase() === cat.toLowerCase()) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });


  async function fetchComments(scriptId, container) {
    try {
      const res = await fetch(`/api/scripts/${scriptId}/comments`);
      const comments = await res.json();
      if (!comments || comments.length === 0) {
        container.innerHTML = `<div class="text-zinc-subtle small py-1">No comments yet. Be the first to comment!</div>`;
        return;
      }

      container.innerHTML = comments.map(c => `
        <div class="d-flex align-items-start gap-2 py-2 border-bottom border-dark">
          <img src="${c.avatar || 'https://api.dicebear.com/7.x/bottts/svg?seed=' + encodeURIComponent(c.user_name)}" width="24" height="24" class="rounded-circle mt-1" alt="User">
          <div class="flex-grow-1">
            <div class="d-flex align-items-center justify-content-between">
              <span class="small font-orbitron fw-bold text-white">${c.user_name}</span>
              <span class="text-zinc-subtle" style="font-size: 0.75rem;">${new Date(c.created_at).toLocaleDateString()}</span>
            </div>
            <div class="text-zinc-muted small">${c.content}</div>
          </div>
        </div>
      `).join('');
    } catch (err) {
      container.innerHTML = `<div class="text-danger small">Failed to load comments</div>`;
    }
  }
</script>

<%- include('partials/footer') %>

  <title><%= typeof title !== 'undefined' ? title + ' - Roblox Script Nexus' : 'Roblox Script Nexus' %></title>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <meta name="description" content="The ultimate vault for free Roblox executor scripts. Browse game maps, copy loadstring shortcuts, build loadouts.">
  
  <!-- Performance & Fast Resource Loading Hints -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
  <link rel="dns-prefetch" href="https://www.highperformanceformat.com">
  <link rel="dns-prefetch" href="https://pl30590575.effectivecpmnetwork.com">
  
  <!-- Google Fonts: Orbitron & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Orbitron:wght@600;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5.3.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- FontAwesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Custom Minimalist Black & Gray UI Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">

  <script>
    window.currentUser = <%- JSON.stringify(typeof currentUser !== 'undefined' ? currentUser : null) %>;

    // Standalone Overlay Creator (100% Zero Dependency & Instant Inline Loading)
    function createCustomNexusOverlay(modalId, innerHtml) {
      var old = document.getElementById(modalId);
      if (old && old.parentNode) old.parentNode.removeChild(old);

      var overlay = document.createElement('div');
      overlay.id = modalId;
      overlay.style.cssText = 'position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(9, 9, 14, 0.94) !important; backdrop-filter: blur(10px) !important; -webkit-backdrop-filter: blur(10px) !important; z-index: 9999999 !important; display: flex !important; align-items: center !important; justify-content: center !important; padding: 15px !important; box-sizing: border-box !important; opacity: 1 !important; visibility: visible !important;';

      var dialog = document.createElement('div');
      dialog.style.cssText = 'width: 100% !important; max-width: 450px !important; background: #0e0e13 !important; border: 1.5px solid #ffaa00 !important; border-radius: 18px !important; box-shadow: 0 20px 60px rgba(0,0,0,0.9), 0 0 30px rgba(255,170,0,0.25) !important; padding: 25px !important; text-align: center !important; color: #ffffff !important; position: relative !important; font-family: system-ui, -apple-system, sans-serif !important;';

      dialog.innerHTML = innerHtml;
      overlay.appendChild(dialog);
      document.body.appendChild(overlay);

      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
          if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        }
      });

      return overlay;
    }

    function showLoginRequiredModal() {
      var html = 
        '<div style="position:absolute; top:12px; right:15px; cursor:pointer; color:#888; font-size:24px; font-weight:bold;" onclick="var m=document.getElementById(\'loginRequiredKeyModal\'); if(m) m.remove();">&times;</div>' +
        '<div style="font-size: 3rem; color: #ffaa00; margin-bottom: 10px;"><i class="fa-solid fa-user-shield"></i></div>' +
        '<h3 style="font-family:inherit; font-size:1.4rem; color:#fff; margin-bottom:10px; font-weight:bold;">ACCOUNT REQUIRED</h3>' +
        '<p style="color:#aaa; font-size:0.9rem; margin-bottom:20px; line-height:1.5;">You must be logged in to generate your personal 24-hour script key. Please sign in or create a free account to continue!</p>' +
        '<a href="/profile" style="display:block; width:100%; padding:14px; background:#ffaa00; color:#0d0d12; font-weight:bold; text-decoration:none; border-radius:30px; margin-bottom:10px; font-size:0.95rem; box-shadow: 0 4px 15px rgba(255,170,0,0.4); box-sizing:border-box;">' +
          '<i class="fa-solid fa-right-to-bracket me-2"></i> SIGN IN / CREATE ACCOUNT' +
        '</a>' +
        '<button onclick="var m=document.getElementById(\'loginRequiredKeyModal\'); if(m) m.remove();" style="display:block; width:100%; padding:10px; background:transparent; color:#888; border:1px solid #333; border-radius:30px; cursor:pointer; font-size:0.85rem;">' +
          'Cancel' +
        '</button>';

      createCustomNexusOverlay('loginRequiredKeyModal', html);
    }

    function showUniqueKeyModal() {
      var html = 
        '<div style="position:absolute; top:12px; right:15px; cursor:pointer; color:#888; font-size:24px; font-weight:bold;" onclick="var m=document.getElementById(\'uniqueKeyGatewayModal\'); if(m) m.remove();">&times;</div>' +
        '<div id="keyTimerSpinner" style="width:3rem; height:3rem; border:3px solid #333; border-top:3px solid #ffaa00; border-radius:50%; margin:0 auto 15px; animation: keySpin 1s linear infinite;"></div>' +
        '<style>@keyframes keySpin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }</style>' +
        '<h3 style="font-family:inherit; font-size:1.3rem; color:#fff; margin-bottom:8px;" id="keyModalStatus">Verifying Sponsor Visit...</h3>' +
        '<p style="color:#aaa; font-size:0.85rem; margin-bottom:15px;">Generating your personal un-shareable 24-hour script key in <strong style="color:#ffaa00; font-size:1.2rem;" id="keyCountdownVal">5</strong> seconds...</p>' +
        '<div style="background:#1a1a24; height:8px; border-radius:4px; overflow:hidden; margin-bottom:15px;">' +
          '<div id="keyProgressBar" style="background:#ffaa00; height:100%; width:0%; transition: width 1s linear;"></div>' +
        '</div>' +
        '<div id="keyResultArea" style="display:none;">' +
          '<div style="background:#14141d; padding:12px; border-radius:10px; border:1px solid #333; margin-bottom:15px;">' +
            '<small style="display:block; color:#888; text-transform:uppercase; font-size:0.75rem; margin-bottom:5px;">Your Personal 24-Hour Key:</small>' +
            '<code id="generatedKeyBox" style="font-size:1.1rem; color:#ffaa00; font-family:monospace; user-select:all; word-break:break-all;">NEXUS-KEY-LOADING</code>' +
          '</div>' +
          '<button id="copyGeneratedKeyBtn" style="display:block; width:100%; padding:12px; background:#ffaa00; color:#0d0d12; font-weight:bold; border:none; border-radius:30px; cursor:pointer; font-size:0.9rem;">' +
            '<i class="fa-solid fa-copy me-2"></i> Copy Personal Key' +
          '</button>' +
        '</div>';

      var overlay = createCustomNexusOverlay('uniqueKeyGatewayModal', html);

      var seconds = 5;
      var countdownVal = document.getElementById('keyCountdownVal');
      var progressBar = document.getElementById('keyProgressBar');
      var spinner = document.getElementById('keyTimerSpinner');
      var statusTxt = document.getElementById('keyModalStatus');
      var resultArea = document.getElementById('keyResultArea');
      var keyBox = document.getElementById('generatedKeyBox');
      var copyBtn = document.getElementById('copyGeneratedKeyBtn');

      var interval = setInterval(function() {
        seconds--;
        if (countdownVal) countdownVal.textContent = seconds;
        if (progressBar) progressBar.style.width = (((5 - seconds) / 5) * 100) + '%';

        if (seconds <= 0) {
          clearInterval(interval);
          if (spinner) spinner.style.display = 'none';
          if (statusTxt) statusTxt.textContent = 'Key Unlocked & Generated!';

          var fallbackKey = 'NEXUS-KEY-' + Math.random().toString(36).substring(2, 8).toUpperCase() + '-' + new Date().toISOString().slice(0,10).replace(/-/g,'');

          fetch('/api/key/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({})
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            var finalKey = (data && data.key) ? data.key : fallbackKey;
            if (keyBox) keyBox.textContent = finalKey;
            if (resultArea) resultArea.style.display = 'block';
            if (copyBtn) {
              copyBtn.onclick = function() {
                if (navigator.clipboard) {
                  navigator.clipboard.writeText(finalKey);
                } else {
                  var ta = document.createElement('textarea');
                  ta.value = finalKey;
                  document.body.appendChild(ta);
                  ta.select();
                  document.execCommand('copy');
                  document.body.removeChild(ta);
                }
                alert('Key copied to clipboard: ' + finalKey);
                if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
              };
            }
          })
          .catch(function(err) {
            if (keyBox) keyBox.textContent = fallbackKey;
            if (resultArea) resultArea.style.display = 'block';
            if (copyBtn) {
              copyBtn.onclick = function() {
                var ta = document.createElement('textarea');
                ta.value = fallbackKey;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                alert('Key copied to clipboard: ' + fallbackKey);
                if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
              };
            }
          });
        }
      }, 1000);
    }

    window.triggerGetDailyKey = function triggerGetDailyKey() {
      if (!window.currentUser) {
        showLoginRequiredModal();
        return;
      }
      try {
        var adUrl = window.adGatewayUrl || 'https://www.effectivecpmnetwork.com/ceafmimnp?key=f32f759ee712c2d7c1dd08569741cc49';
        window.open(adUrl, '_blank');
      } catch(e) {
        console.warn('Ad gateway open error:', e);
      }
      setTimeout(function() { showUniqueKeyModal(); }, 300);
    };
  </script>

  <!-- Language Switcher Core -->
  <script src="/js/lang.js"></script>
</head>

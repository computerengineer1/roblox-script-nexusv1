<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - Roblox Script Nexus' : 'Roblox Script Nexus' %></title>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <meta name="description" content="The ultimate vault for free Roblox executor scripts. Browse game maps, copy loadstring shortcuts, build loadouts.">
  
  <!-- Favicon & Brand Icons -->
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <meta property="og:image" content="/images/logo.png">
  <meta name="twitter:image" content="/images/logo.png">
  
  <!-- ULTRA-FAST Performance: DNS Prefetch + Preconnect all CDNs -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  
  <!-- CRITICAL: Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- CRITICAL: Custom Luxury Black & Gray UI Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- NON-BLOCKING: Google Fonts loaded async -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@600;800;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@600;800;900&display=swap" rel="stylesheet"></noscript>
  
  <!-- NON-BLOCKING: FontAwesome loaded async -->
  <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>

  <!-- Instant skeleton paint: show dark structure immediately -->
  <style>
    body{background:#050507;color:#f4f4f5;font-family:system-ui,-apple-system,sans-serif}
    .navbar{background:rgba(5,5,7,.85)!important;backdrop-filter:blur(16px)}
    .glass-card{background:rgba(18,18,22,.75);border:1px solid rgba(255,255,255,.08);border-radius:16px}
    .font-orbitron{font-family:'Orbitron',system-ui,sans-serif}
    .btn-zinc-white{background:#ffffff;color:#050507;border:1px solid #fff}
  </style>

  <script>
    window.currentUser = <%- JSON.stringify(typeof currentUser !== 'undefined' ? currentUser : null) %>;

    // Standalone Titanium Overlay Creator
    function createCustomNexusOverlay(modalId, innerHtml) {
      var old = document.getElementById(modalId);
      if (old && old.parentNode) old.parentNode.removeChild(old);

      var overlay = document.createElement('div');
      overlay.id = modalId;
      overlay.style.cssText = 'position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(5, 5, 7, 0.94) !important; backdrop-filter: blur(14px) !important; -webkit-backdrop-filter: blur(14px) !important; z-index: 9999999 !important; display: flex !important; align-items: center !important; justify-content: center !important; padding: 15px !important; box-sizing: border-box !important; opacity: 1 !important; visibility: visible !important;';

      var dialog = document.createElement('div');
      dialog.style.cssText = 'width: 100% !important; max-width: 460px !important; background: #0c0c10 !important; border: 1.5px solid rgba(255, 255, 255, 0.2) !important; border-radius: 20px !important; box-shadow: 0 25px 70px rgba(0,0,0,0.95), 0 0 35px rgba(255,255,255,0.06) !important; padding: 28px !important; text-align: center !important; color: #ffffff !important; position: relative !important; font-family: system-ui, -apple-system, sans-serif !important;';

      dialog.innerHTML = innerHtml;
      overlay.appendChild(dialog);
      document.body.appendChild(overlay);

      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
          if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        }
      });

      return overlay;
    }

    function showLoginRequiredModal() {
      var html = 
        '<div style="position:absolute; top:15px; right:18px; cursor:pointer; color:#888; font-size:22px; font-weight:bold;" onclick="var m=document.getElementById(\'loginRequiredKeyModal\'); if(m) m.remove();">&times;</div>' +
        '<div style="font-size: 2.8rem; color: #ffffff; margin-bottom: 10px;"><i class="fa-solid fa-shield-halved"></i></div>' +
        '<h3 style="font-family:inherit; font-size:1.35rem; color:#fff; margin-bottom:10px; font-weight:bold;">ACCOUNT REQUIRED</h3>' +
        '<p style="color:#a1a1aa; font-size:0.9rem; margin-bottom:20px; line-height:1.5;">You must be signed in to generate your unique 24-hour executor key. Please create a free account or sign in to continue!</p>' +
        '<a href="/profile" style="display:block; width:100%; padding:14px; background:#ffffff; color:#050507; font-weight:bold; text-decoration:none; border-radius:30px; margin-bottom:10px; font-size:0.95rem; box-shadow: 0 4px 20px rgba(255,255,255,0.25); box-sizing:border-box;">' +
          '<i class="fa-solid fa-right-to-bracket me-2"></i> SIGN IN / CREATE ACCOUNT' +
        '</a>' +
        '<button onclick="var m=document.getElementById(\'loginRequiredKeyModal\'); if(m) m.remove();" style="display:block; width:100%; padding:10px; background:transparent; color:#71717a; border:1px solid #27272a; border-radius:30px; cursor:pointer; font-size:0.85rem;">' +
          'Cancel' +
        '</button>';

      createCustomNexusOverlay('loginRequiredKeyModal', html);
    }

    function showUniqueKeyModal() {
      var html = 
        '<div style="position:absolute; top:15px; right:18px; cursor:pointer; color:#888; font-size:22px; font-weight:bold;" onclick="var m=document.getElementById(\'uniqueKeyGatewayModal\'); if(m) m.remove();">&times;</div>' +
        '<div id="keyTimerSpinner" style="width:2.8rem; height:2.8rem; border:3px solid #27272a; border-top:3px solid #ffffff; border-radius:50%; margin:0 auto 15px; animation: keySpin 1s linear infinite;"></div>' +
        '<style>@keyframes keySpin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }</style>' +
        '<h3 style="font-family:inherit; font-size:1.3rem; color:#fff; margin-bottom:8px;" id="keyModalStatus">Verifying Sponsor Access...</h3>' +
        '<p style="color:#a1a1aa; font-size:0.85rem; margin-bottom:15px;">Generating your personal 24-hour key in <strong style="color:#ffffff; font-size:1.2rem;" id="keyCountdownVal">5</strong> seconds...</p>' +
        '<div style="background:#18181b; height:6px; border-radius:3px; overflow:hidden; margin-bottom:18px; border:1px solid #27272a;">' +
          '<div id="keyProgressBar" style="background:#ffffff; height:100%; width:0%; transition: width 1s linear;"></div>' +
        '</div>' +
        '<div id="keyResultArea" style="display:none;">' +
          '<div style="background:#141418; padding:14px; border-radius:12px; border:1px solid #27272a; margin-bottom:15px;">' +
            '<small style="display:block; color:#71717a; text-transform:uppercase; font-size:0.75rem; margin-bottom:6px; letter-spacing:0.5px;">Your Personal 24-Hour Key:</small>' +
            '<code id="generatedKeyBox" style="font-size:1.15rem; color:#ffffff; font-family:monospace; user-select:all; word-break:break-all; font-weight:bold;">NEXUS-KEY-LOADING</code>' +
          '</div>' +
          '<button id="copyGeneratedKeyBtn" style="display:block; width:100%; padding:13px; background:#ffffff; color:#050507; font-weight:bold; border:none; border-radius:30px; cursor:pointer; font-size:0.9rem; box-shadow: 0 0 20px rgba(255,255,255,0.3);">' +
            '<i class="fa-solid fa-copy me-2"></i> COPY 24-HOUR KEY' +
          '</button>' +
        '</div>';

      var overlay = createCustomNexusOverlay('uniqueKeyGatewayModal', html);

      var seconds = 5;
      var countdownVal = document.getElementById('keyCountdownVal');
      var progressBar = document.getElementById('keyProgressBar');
      var spinner = document.getElementById('keyTimerSpinner');
      var statusTxt = document.getElementById('keyModalStatus');
      var resultArea = document.getElementById('keyResultArea');
      var keyBox = document.getElementById('generatedKeyBox');
      var copyBtn = document.getElementById('copyGeneratedKeyBtn');

      var interval = setInterval(function() {
        seconds--;
        if (countdownVal) countdownVal.textContent = seconds;
        if (progressBar) progressBar.style.width = (((5 - seconds) / 5) * 100) + '%';

        if (seconds <= 0) {
          clearInterval(interval);
          if (spinner) spinner.style.display = 'none';
          if (statusTxt) statusTxt.textContent = 'Key Unlocked & Ready!';

          var fallbackKey = 'NEXUS-KEY-' + Math.random().toString(36).substring(2, 8).toUpperCase() + '-' + new Date().toISOString().slice(0,10).replace(/-/g,'');

          fetch('/api/key/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({})
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            var finalKey = (data && data.key) ? data.key : fallbackKey;
            if (keyBox) keyBox.textContent = finalKey;
            if (resultArea) resultArea.style.display = 'block';
            if (copyBtn) {
              copyBtn.onclick = function() {
                if (navigator.clipboard) {
                  navigator.clipboard.writeText(finalKey);
                }
                alert('Key copied to clipboard: ' + finalKey);
                if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
              };
            }
          })
          .catch(function() {
            if (keyBox) keyBox.textContent = fallbackKey;
            if (resultArea) resultArea.style.display = 'block';
            if (copyBtn) {
              copyBtn.onclick = function() {
                if (navigator.clipboard) {
                  navigator.clipboard.writeText(fallbackKey);
                }
                alert('Key copied to clipboard: ' + fallbackKey);
                if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
              };
            }
          });
        }
      }, 1000);
    }

    window.triggerGetDailyKey = function triggerGetDailyKey() {
      if (!window.currentUser) {
        showLoginRequiredModal();
        return;
      }
      try {
        var adUrl = window.adGatewayUrl || 'https://www.effectivecpmnetwork.com/ceafmimnp?key=f32f759ee712c2d7c1dd08569741cc49';
        window.open(adUrl, '_blank');
      } catch(e) {
        console.warn('Ad gateway open error:', e);
      }
      setTimeout(function() { showUniqueKeyModal(); }, 300);
    };
  </script>

  <!-- Language Switcher Core -->
  <script src="/js/lang.js"></script>
</head>
<body class="text-light min-vh-100 d-flex flex-column">

  <!-- Main Navigation Bar -->
  <nav class="navbar navbar-expand-lg sticky-top nexus-navbar">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/images/logo.png" alt="Script Nexus Logo" width="34" height="34" class="rounded-2 border border-secondary p-1 bg-dark">
        <span class="brand-text">SCRIPT<span class="text-zinc-light ms-1">NEXUS</span></span>
      </a>
      
      <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#nexusNav" aria-controls="nexusNav" aria-expanded="false" aria-label="Toggle navigation">
        <i class="fa-solid fa-bars fs-4"></i>
      </button>
      
      <div class="collapse navbar-collapse" id="nexusNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
          <li class="nav-item">
            <a class="nav-link nav-nexus" href="/"><i class="fa-solid fa-house me-1"></i> <span data-i18n="home">Home</span></a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-nexus" href="/playground"><i class="fa-solid fa-terminal me-1"></i> <span data-i18n="playground">Playground</span></a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-nexus" href="/loadout"><i class="fa-solid fa-layer-group me-1"></i> <span data-i18n="loadouts">Loadouts</span> <span id="loadoutBadge" class="badge bg-dark border border-secondary text-white rounded-pill d-none">0</span></a>
          </li>
          <li class="nav-item">
            <a href="/key" class="nav-link nav-nexus text-white fw-bold border-0 bg-transparent titanium-glow-btn px-3 rounded-pill ms-lg-2" onclick="if(window.triggerGetDailyKey){window.triggerGetDailyKey(event); return false;}"><i class="fa-solid fa-key me-1"></i> <span>Get 24h Key</span></a>
          </li>
        </ul>
        
        <div class="d-flex align-items-center gap-2">
          <!-- Command Palette Shortcut Trigger -->
          <button onclick="if(window.openCmdPalette) window.openCmdPalette();" class="btn btn-zinc-dark btn-sm px-3 rounded-pill font-orbitron d-none d-md-flex align-items-center gap-2" title="Quick Search (Ctrl + K)">
            <i class="fa-solid fa-magnifying-glass text-secondary"></i>
            <span class="kbd-badge">Ctrl + K</span>
          </button>

          <!-- Sound FX Toggle Button -->
          <button onclick="window.nexusSFX.toggle();" class="btn sfx-toggle-btn" title="Toggle Sound FX (Press M)">
            <i class="fa-solid fa-volume-high text-white"></i>
            <span class="d-none d-lg-inline">SFX</span>
          </button>

          <!-- Language Toggle -->
          <button id="langToggleBtn" onclick="toggleLang()" class="btn btn-zinc-dark btn-sm px-3 rounded-pill font-orbitron" title="Switch Language">
            العربية
          </button>

          <!-- Community User Profile / Login -->
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <a href="/profile" class="btn btn-zinc-dark btn-sm px-3 rounded-pill d-flex align-items-center gap-2">
              <img src="<%= currentUser.avatar || 'https://api.dicebear.com/7.x/bottts/svg?seed=' + encodeURIComponent(currentUser.name) %>" width="22" height="22" class="rounded-circle" alt="<%= currentUser.name %>" referrerpolicy="no-referrer">
              <span class="small font-orbitron"><%= currentUser.name %></span>
            </a>
          <% } else { %>
            <a href="/profile" class="btn btn-zinc-white btn-sm px-3 rounded-pill font-orbitron">
              <i class="fa-solid fa-user me-1"></i> <span data-i18n="sign_in">Sign In</span>
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Top Header Leaderboard Ad Unit (728x90 / 320x50) -->
  <div class="container mt-2">
    <%- include('adsense', { pos: 'Top Header Banner' }) %>
  </div>

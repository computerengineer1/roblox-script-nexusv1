<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - Roblox Script Nexus' : 'Roblox Script Nexus Ultimate' %></title>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  
  <!-- Google Fonts: Orbitron & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Orbitron:wght@600;800;900&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5.3.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- FontAwesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Custom Neon Game UI Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-nexus text-light min-vh-100 d-flex flex-column">

  <!-- Main Navigation Bar -->
  <nav class="navbar navbar-expand-lg sticky-top nexus-navbar">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <i class="fa-solid fa-bolt text-cyan fs-3"></i>
        <span class="brand-text">SCRIPT <span class="text-neon-cyan">NEXUS</span></span>
      </a>
      
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nexusNav" aria-controls="nexusNav" aria-expanded="false" aria-label="Toggle navigation">
        <i class="fa-solid fa-bars text-cyan fs-4"></i>
      </button>
      
      <div class="collapse navbar-collapse" id="nexusNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
          <li class="nav-item">
            <a class="nav-link nav-nexus" href="/"><i class="fa-solid fa-house me-1"></i> Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-nexus" href="/playground"><i class="fa-solid fa-terminal me-1"></i> Playground</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-nexus" href="/loadout"><i class="fa-solid fa-layer-group me-1"></i> Loadout Builder <span id="loadoutBadge" class="badge bg-purple rounded-pill d-none">0</span></a>
          </li>
        </ul>
        
        <div class="d-flex align-items-center gap-3">
          <!-- Admin Panel Button -->
          <a href="/admin" class="btn btn-outline-cyan btn-sm px-3 rounded-pill fw-bold">
            <i class="fa-solid fa-user-shield me-1"></i> Admin Portal
          </a>
        </div>
      </div>
    </div>
  </nav>

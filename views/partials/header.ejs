<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - Roblox Script Nexus' : 'Roblox Script Nexus' %></title>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <meta name="description" content="The ultimate vault for free Roblox executor scripts. Browse game maps, copy loadstring shortcuts, build loadouts.">
  
  <!-- Performance & Fast Resource Loading Hints -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
  <link rel="dns-prefetch" href="https://www.highperformanceformat.com">
  <link rel="dns-prefetch" href="https://pl30590575.effectivecpmnetwork.com">
  
  <!-- Google Fonts: Orbitron & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Orbitron:wght@600;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5.3.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- FontAwesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Custom Minimalist Black & Gray UI Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Language Switcher Core -->
  <script src="/js/lang.js"></script>
</head>
<body class="text-light min-vh-100 d-flex flex-column">

  <!-- Main Navigation Bar -->
  <nav class="navbar navbar-expand-lg sticky-top nexus-navbar">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <div class="brand-badge bg-zinc-dark p-2 rounded-3 border border-secondary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
          <i class="fa-solid fa-cube text-white fs-5"></i>
        </div>
        <span class="brand-text">SCRIPT<span class="text-zinc-muted">NEXUS</span></span>
      </a>
      
      <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#nexusNav" aria-controls="nexusNav" aria-expanded="false" aria-label="Toggle navigation">
        <i class="fa-solid fa-bars fs-4"></i>
      </button>
      
      <div class="collapse navbar-collapse" id="nexusNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
          <li class="nav-item">
            <a class="nav-link nav-nexus" href="/"><i class="fa-solid fa-house me-1"></i> <span data-i18n="home">Home</span></a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-nexus" href="/playground"><i class="fa-solid fa-terminal me-1"></i> <span data-i18n="playground">Playground</span></a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-nexus" href="/loadout"><i class="fa-solid fa-layer-group me-1"></i> <span data-i18n="loadouts">Loadouts</span> <span id="loadoutBadge" class="badge bg-zinc-dark border border-secondary rounded-pill d-none">0</span></a>
          </li>
          <li class="nav-item">
            <button class="nav-link nav-nexus text-warning fw-bold border-0 bg-transparent" onclick="triggerGetDailyKey()"><i class="fa-solid fa-key me-1 text-warning"></i> <span>Get 24h Key</span></button>
          </li>
        </ul>
        
        <div class="d-flex align-items-center gap-3">
          <!-- Language Toggle -->
          <button id="langToggleBtn" onclick="toggleLang()" class="btn btn-zinc-dark btn-sm px-3 rounded-pill font-orbitron" title="Switch Language">
            العربية
          </button>

          <!-- Community User Profile / Login -->
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <a href="/profile" class="btn btn-zinc-dark btn-sm px-3 rounded-pill d-flex align-items-center gap-2">
              <img src="<%= currentUser.avatar || 'https://api.dicebear.com/7.x/bottts/svg?seed=' + encodeURIComponent(currentUser.name) %>" width="22" height="22" class="rounded-circle" alt="<%= currentUser.name %>" referrerpolicy="no-referrer">
              <span class="small font-orbitron"><%= currentUser.name %></span>
            </a>
          <% } else { %>
            <a href="/profile" class="btn btn-zinc-white btn-sm px-3 rounded-pill font-orbitron">
              <i class="fa-solid fa-user me-1"></i> <span data-i18n="sign_in">Sign In</span>
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Top Header Leaderboard Ad Unit (728x90 / 320x50) -->
  <div class="container mt-2">
    <%- include('adsense', { pos: 'Top Header Banner' }) %>
  </div>

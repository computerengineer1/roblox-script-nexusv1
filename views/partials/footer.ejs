  <!-- Automatic Pop-under Ad Trigger (Monetag / Adsterra / Direct Link) -->
  <script>
    document.addEventListener('click', function triggerGlobalPopunder(e) {
      // Exclude clicks inside inputs, buttons or interactive elements to preserve UX
      if (e.target.closest('button') || e.target.closest('a') || e.target.closest('input')) return;

      const lastPopTime = localStorage.getItem('nexus_global_pop_time');
      const now = Date.now();
      
      // Cooldown of 4 hours between full screen popunders
      if (!lastPopTime || (now - parseInt(lastPopTime, 10)) > (4 * 60 * 60 * 1000)) {
        const adUrl = '<%= typeof adGatewayUrl !== "undefined" && adGatewayUrl ? adGatewayUrl : "https://www.google.com" %>';
        if (adUrl && adUrl.startsWith('http')) {
          window.open(adUrl, '_blank');
          localStorage.setItem('nexus_global_pop_time', now);
        }
      }
    });
  </script>

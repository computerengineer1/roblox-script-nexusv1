<%- include('../partials/header', { title: 'Admin Dashboard - Roblox Script Nexus' }) %>

<main class="container py-4 flex-grow-1">

  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h1 class="display-6 font-orbitron text-neon-cyan mb-1">
        <i class="fa-solid fa-gauge-high me-2"></i>NEXUS COMMAND DASHBOARD
      </h1>
      <p class="text-secondary mb-0">Welcome back, <strong class="text-cyan"><%= user.username %></strong>. System status: Operational.</p>
    </div>
    
    <div class="d-flex align-items-center gap-2">
      <a href="/admin/logout" class="btn btn-outline-danger btn-sm font-orbitron rounded-pill px-3">
        <i class="fa-solid fa-power-off me-1"></i> Sign Out
      </a>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger border-0 bg-dark-glass text-danger rounded-3 mb-4">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
    </div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success border-0 bg-dark-glass text-success rounded-3 mb-4">
      <i class="fa-solid fa-circle-check me-2"></i><%= success %>
    </div>
  <% } %>

  <!-- Stats Cards Row -->
  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card glass-card border-cyan rounded-4 p-3 text-center">
        <div class="text-cyan font-orbitron small">TOTAL MAPS</div>
        <div class="display-5 font-orbitron text-light fw-bold my-1"><%= stats.mapCount || 0 %></div>
        <small class="text-secondary">Game Vault Categories</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card glass-card border-purple rounded-4 p-3 text-center">
        <div class="text-purple font-orbitron small">TOTAL SCRIPTS</div>
        <div class="display-5 font-orbitron text-light fw-bold my-1"><%= stats.scriptCount || 0 %></div>
        <small class="text-secondary">Published Lua Code</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card glass-card border-cyan rounded-4 p-3 text-center">
        <div class="text-cyan font-orbitron small">TOTAL SCRIPT COPIES</div>
        <div class="display-5 font-orbitron text-light fw-bold my-1"><%= stats.copyCount || 0 %></div>
        <small class="text-secondary">User Copy Events</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card glass-card border-purple rounded-4 p-3 text-center">
        <div class="text-purple font-orbitron small">MAP VIEWS</div>
        <div class="display-5 font-orbitron text-light fw-bold my-1"><%= stats.viewCount || 0 %></div>
        <small class="text-secondary">Page Impressions</small>
      </div>
    </div>
  </div>

  <!-- Management Tabs Section -->
  <ul class="nav nav-tabs border-purple mb-4" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active font-orbitron text-cyan" id="maps-tab" data-bs-toggle="tab" data-bs-target="#maps-pane" type="button" role="tab"><i class="fa-solid fa-gamepad me-2"></i>Manage Maps</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link font-orbitron text-cyan" id="scripts-tab" data-bs-toggle="tab" data-bs-target="#scripts-pane" type="button" role="tab"><i class="fa-solid fa-scroll me-2"></i>Manage Scripts</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link font-orbitron text-cyan" id="analytics-tab" data-bs-toggle="tab" data-bs-target="#analytics-pane" type="button" role="tab"><i class="fa-solid fa-chart-bar me-2"></i>Analytics</button>
    </li>
  </ul>

  <div class="tab-content" id="adminTabsContent">

    <!-- MAPS MANAGEMENT PANE -->
    <div class="tab-pane fade show active" id="maps-pane" role="tabpanel">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="font-orbitron text-neon-cyan mb-0">Game Maps Catalog</h4>
        <button class="btn btn-cyan text-dark font-orbitron btn-sm fw-bold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addMapModal">
          <i class="fa-solid fa-plus me-1"></i> Add New Map
        </button>
      </div>

      <div class="table-responsive glass-card rounded-4 border-purple p-3">
        <table class="table table-dark table-hover align-middle mb-0">
          <thead>
            <tr class="font-orbitron text-cyan">
              <th>Thumbnail</th>
              <th>Map Name</th>
              <th>Description</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (maps && maps.length > 0) { %>
              <% maps.forEach(map => { %>
                <tr>
                  <td>
                    <img src="<%= map.image %>" class="rounded object-fit-cover" style="width: 60px; height: 40px;" alt="<%= map.name %>">
                  </td>
                  <td class="fw-bold font-orbitron text-light"><%= map.name %></td>
                  <td class="text-secondary small text-truncate" style="max-width: 300px;"><%= map.description %></td>
                  <td class="text-secondary small"><%= new Date(map.created_at).toLocaleDateString() %></td>
                  <td>
                    <form action="/admin/maps/delete/<%= map.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this map and all its scripts?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle" title="Delete Map">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" class="text-center text-secondary py-4">No maps in database.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- SCRIPTS MANAGEMENT PANE -->
    <div class="tab-pane fade" id="scripts-pane" role="tabpanel">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="font-orbitron text-neon-cyan mb-0">Published Script Repository</h4>
        <button class="btn btn-cyan text-dark font-orbitron btn-sm fw-bold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addScriptModal">
          <i class="fa-solid fa-plus me-1"></i> Add New Script
        </button>
      </div>

      <div class="table-responsive glass-card rounded-4 border-purple p-3">
        <table class="table table-dark table-hover align-middle mb-0">
          <thead>
            <tr class="font-orbitron text-cyan">
              <th>Title</th>
              <th>Map</th>
              <th>Category</th>
              <th>Code Snippet</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (scripts && scripts.length > 0) { %>
              <% scripts.forEach(s => { %>
                <tr>
                  <td class="fw-bold font-orbitron text-light"><%= s.title %></td>
                  <td><span class="badge bg-purple"><%= s.map_name %></span></td>
                  <td><span class="badge bg-dark-glass text-cyan border-cyan"><%= s.category %></span></td>
                  <td class="font-monospace text-secondary small text-truncate" style="max-width: 250px;"><%= s.code %></td>
                  <td>
                    <form action="/admin/scripts/delete/<%= s.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this script?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle" title="Delete Script">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" class="text-center text-secondary py-4">No scripts uploaded yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ANALYTICS PANE -->
    <div class="tab-pane fade" id="analytics-pane" role="tabpanel">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="card glass-card border-purple p-4 rounded-4">
            <h5 class="font-orbitron text-neon-cyan mb-3"><i class="fa-solid fa-fire me-2"></i>Most Copied Scripts</h5>
            <ul class="list-group list-group-flush bg-transparent">
              <% if (topScripts && topScripts.length > 0) { %>
                <% topScripts.forEach(ts => { %>
                  <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center">
                    <div>
                      <strong class="text-cyan"><%= ts.title %></strong>
                      <small class="text-secondary d-block"><%= ts.map_name %></small>
                    </div>
                    <span class="badge bg-purple font-orbitron px-3 py-2"><%= ts.copies %> Copies</span>
                  </li>
                <% }) %>
              <% } else { %>
                <li class="list-group-item bg-transparent text-secondary">No copy analytics data yet.</li>
              <% } %>
            </ul>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card glass-card border-cyan p-4 rounded-4">
            <h5 class="font-orbitron text-neon-purple mb-3"><i class="fa-solid fa-eye me-2"></i>Most Viewed Maps</h5>
            <ul class="list-group list-group-flush bg-transparent">
              <% if (topMaps && topMaps.length > 0) { %>
                <% topMaps.forEach(tm => { %>
                  <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center">
                    <strong class="text-purple"><%= tm.name %></strong>
                    <span class="badge bg-dark-glass text-cyan border-cyan font-orbitron px-3 py-2"><%= tm.views %> Views</span>
                  </li>
                <% }) %>
              <% } else { %>
                <li class="list-group-item bg-transparent text-secondary">No map view data yet.</li>
              <% } %>
            </ul>
          </div>
        </div>
      </div>
    </div>

  </div>

</main>

<!-- ADD MAP MODAL -->
<div class="modal fade" id="addMapModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content glass-card border-cyan text-light">
      <form action="/admin/maps/add" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <div class="modal-header border-purple">
          <h5 class="modal-title font-orbitron text-neon-cyan">Add New Game Map</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        
        <div class="modal-body">
          <div class="mb-3">
            <label for="mapName" class="form-label font-orbitron small text-cyan">MAP NAME</label>
            <input type="text" id="mapName" name="name" class="form-control bg-dark-glass text-light border-cyan" required placeholder="e.g. Grand Piece Online">
          </div>
          <div class="mb-3">
            <label for="mapImage" class="form-label font-orbitron small text-cyan">MAP IMAGE (JPG, PNG, WEBP)</label>
            <input type="file" id="mapImage" name="image" class="form-control bg-dark-glass text-light border-cyan" accept="image/*">
          </div>
          <div class="mb-3">
            <label for="mapDesc" class="form-label font-orbitron small text-cyan">DESCRIPTION</label>
            <textarea id="mapDesc" name="description" class="form-control bg-dark-glass text-light border-cyan" rows="3" placeholder="Brief map description..."></textarea>
          </div>
        </div>

        <div class="modal-footer border-purple">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-cyan text-dark font-orbitron fw-bold rounded-pill">Save Map</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ADD SCRIPT MODAL -->
<div class="modal fade" id="addScriptModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content glass-card border-purple text-light">
      <form action="/admin/scripts/add" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="modal-header border-purple">
          <h5 class="modal-title font-orbitron text-neon-cyan">Add New Roblox Script</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="scriptTitle" class="form-label font-orbitron small text-cyan">SCRIPT TITLE</label>
              <input type="text" id="scriptTitle" name="title" class="form-control bg-dark-glass text-light border-cyan" required placeholder="e.g. Infinite Money & ESP Hub">
            </div>
            <div class="col-md-6 mb-3">
              <label for="mapSelect" class="form-label font-orbitron small text-cyan">ASSIGN TO MAP</label>
              <select id="mapSelect" name="map_id" class="form-select bg-dark-glass text-light border-cyan" required>
                <% if (maps && maps.length > 0) { %>
                  <% maps.forEach(m => { %>
                    <option value="<%= m.id %>"><%= m.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label for="scriptCategory" class="form-label font-orbitron small text-cyan">CATEGORY</label>
            <input type="text" id="scriptCategory" name="category" class="form-control bg-dark-glass text-light border-cyan" placeholder="Farming, Combat, Visuals, Movement...">
          </div>

          <div class="mb-3">
            <label for="scriptDesc" class="form-label font-orbitron small text-cyan">DESCRIPTION</label>
            <input type="text" id="scriptDesc" name="description" class="form-control bg-dark-glass text-light border-cyan" placeholder="Features list & instructions...">
          </div>

          <div class="mb-3">
            <label for="scriptCode" class="form-label font-orbitron small text-cyan">LUA SCRIPT CODE</label>
            <textarea id="scriptCode" name="code" class="form-control bg-dark-glass text-light border-cyan font-monospace" rows="6" required placeholder="loadstring(game:HttpGet(...))()"></textarea>
            <small class="text-secondary d-block mt-1">Note: Code will be scanned by strict security filter for os.execute/io.popen prohibited patterns.</small>
          </div>
        </div>

        <div class="modal-footer border-purple">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-purple font-orbitron fw-bold rounded-pill px-4">Publish Script</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
